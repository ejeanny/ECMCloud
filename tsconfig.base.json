{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@ecm/domain": ["packages/domain/src/index.ts"],
      "@ecm/db": ["packages/db/src/index.ts"],
      "@ecm/api": ["apps/api/src/index.ts"],
      "@ecm/api/router": ["apps/api/src/routers/index.ts"]
    }
  }
}
