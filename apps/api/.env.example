# --- database -----------------------------------------------------------
# Prisma Postgres. Both strings come from the database's Console page: the
# pooled one for the application, the direct one for the CLI. `sslmode=require`
# is not optional — Prisma Postgres refuses a plaintext connection.
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
DIRECT_DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# An ordinary PostgreSQL instead: one URL, and DIRECT_DATABASE_URL stays unset
# (the CLI falls back to this one).
#   DATABASE_URL="postgresql://ecm:ecm@localhost:5432/ecm?schema=public"

# --- repository ---------------------------------------------------------
REPOSITORY_ROOT="./repository"
# Leave blank unless a cabinet has repoEncrypted = true; blank means "no key",
# and the API only requires one when it has to unwrap an encrypted file.
# 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
REPOSITORY_MASTER_KEY=""

# --- document conversion ------------------------------------------------
# Opens Word, Excel and PowerPoint in the PDF viewer, with the annotations,
# search and thumbnails that only PDF pages have. Blank turns the feature off:
# office documents keep the renderers they have, and the viewer is told not to
# ask for a PDF it cannot get.
#
# LibreOffice is what this is written for. Install it and point at soffice:
#   Windows  C:\Program Files\LibreOffice\program\soffice.exe
#   macOS    /Applications/LibreOffice.app/Contents/MacOS/soffice
#   Linux    /usr/bin/soffice        (apt install libreoffice --no-install-recommends)
#
# It runs a large C++ parser over uploaded documents. On anything facing the
# public internet, run it as an unprivileged user in a container with no
# network; see the header of apps/api/src/convert.ts.
OFFICE_CONVERT_COMMAND=""

# Arguments placed before the ones the converter builds. Only needed to point
# at a wrapper: a .cmd or .bat cannot be spawned directly on Windows, so name
# the interpreter above and the script here.
OFFICE_CONVERT_ARGS=""

# Where converted PDFs are kept. Derived bytes only — deleting any of it costs
# a reconversion and nothing else. Defaults to a folder in the system temp
# directory, which is why it is not in the repository.
RENDITION_CACHE_DIR=""

# --- server -------------------------------------------------------------
SESSION_TTL_MINUTES=480
WEB_ORIGIN="http://localhost:3000"
HOST=127.0.0.1
PORT=4000
NODE_ENV=development
