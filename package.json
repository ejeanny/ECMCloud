{
  "name": "ecm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @ecm/domain && npm run build -w @ecm/db && npm run build -w @ecm/api && npm run build -w @ecm/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @ecm/api",
    "dev:web": "npm run dev -w @ecm/web",
    "db:generate": "npm run generate -w @ecm/db",
    "db:push": "npm run push -w @ecm/db",
    "db:seed": "npm run seed -w @ecm/db",
    "test": "node tests/run.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
